{
  "name": "mapmycams",
  "main": "api/index.js",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // API paths must reach the worker before the SPA fallback serves index.html.
    "run_worker_first": [
      "/auth/*",
      "/me",
      "/floorplans/*",
      "/billing/*",
      "/webhooks/*",
      "/admin/*",
      "/ai/*",
      "/analytics"
    ]
  }
}
